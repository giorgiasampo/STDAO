PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX st: <http://www.semanticweb.org/gisa/STDAO/>
PREFIX old: <http://www.semanticweb.org/gisa/#STDAO:>
SELECT ?property ?domain ?range ?minimum ?filler WHERE {
 VALUES ?property { st:DAOIsInstantiationOf st:hasDAOMember }
 ?property rdfs:domain ?domain ; rdfs:range ?range .
 st:DAO rdfs:subClassOf ?restriction . ?restriction owl:onProperty ?property ; owl:minQualifiedCardinality ?minimum ; owl:onClass ?filler .
} ORDER BY ?property
