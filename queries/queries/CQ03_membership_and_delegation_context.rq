PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX st: <http://www.semanticweb.org/gisa/STDAO/>
PREFIX old: <http://www.semanticweb.org/gisa/#STDAO:>
SELECT ?record ?property ?count ?filler WHERE {
 VALUES ?record { st:membershipRecord st:tokenDelegation }
 ?record rdfs:subClassOf ?restriction . ?restriction owl:onProperty ?property ; owl:qualifiedCardinality ?count ; owl:onClass ?filler .
} ORDER BY ?record ?property
