PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX st: <http://www.semanticweb.org/gisa/STDAO/>
PREFIX old: <http://www.semanticweb.org/gisa/#STDAO:>
SELECT ?layerLabel ?classLabel ?class WHERE {
 VALUES ?layer { st:technicalArtefactualLayer old:governanceIntermediationLayer st:organizationalManifestationLayer }
 ?layer rdfs:label ?layerLabel . ?class a owl:Class ; rdfs:subClassOf* ?layer ; rdfs:label ?classLabel .
 FILTER(isIRI(?class))
} ORDER BY ?layerLabel ?classLabel
