PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX st: <http://www.semanticweb.org/gisa/STDAO/>
PREFIX old: <http://www.semanticweb.org/gisa/#STDAO:>
SELECT ?property ?endpoint ?member WHERE {
 VALUES ?endpoint { rdfs:domain rdfs:range }
 ?property ?endpoint ?expression . ?expression owl:intersectionOf/rdf:rest*/rdf:first ?member . FILTER(isIRI(?member))
} ORDER BY ?property ?endpoint ?member
