PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX st: <http://www.semanticweb.org/gisa/STDAO/>
PREFIX old: <http://www.semanticweb.org/gisa/#STDAO:>
SELECT ?property ?domain ?range WHERE {
 VALUES ?property { st:changesStatusQuo st:shapesStatusQuo st:distributionIsReflectedIn st:givesGovernanceRight st:hasGovernanceSystem }
 ?property rdfs:domain ?domain ; rdfs:range ?range . FILTER(isIRI(?domain) && isIRI(?range))
} ORDER BY ?property
