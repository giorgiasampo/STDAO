PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX st: <http://www.semanticweb.org/gisa/STDAO/>
PREFIX old: <http://www.semanticweb.org/gisa/#STDAO:>
SELECT ?property ?domainLabel ?rangeLabel ?inverse WHERE {
 VALUES ?property { st:reputationEnablesSpecialRightsAllocation st:specialRightsAreHeldBy st:specialRightsAreGivenBy }
 ?property rdfs:domain ?domain ; rdfs:range ?range .
 ?domain rdfs:label ?domainLabel .
 { ?range rdfs:label ?rangeLabel } UNION { ?range owl:unionOf/rdf:rest*/rdf:first/rdfs:label ?rangeLabel }
 OPTIONAL { { ?property owl:inverseOf ?inverse } UNION { ?inverse owl:inverseOf ?property } }
} ORDER BY ?property ?rangeLabel
