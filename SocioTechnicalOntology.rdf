        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <st:multiplicity xml:lang="en">tokenDelegation → tokenOwner: 1..1; inverse normally 0..*.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">The one token owner assigning the delegation.</rdfs:comment>
        <rdfs:label xml:lang="en">Delegation From</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/delegationTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/delegationTo">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/hasIncomingDelegation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenDelegation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/delegateVoter"/>
        <st:multiplicity xml:lang="en">tokenDelegation → delegateVoter: 1..1; inverse normally 0..*.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">The one voter receiving delegated voting authority.</rdfs:comment>
