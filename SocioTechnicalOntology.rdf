        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#hasSmartContract"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/textuallyEncodes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/textuallyEncodes">
        <rdfs:domain>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/proposalText"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/smartContractContent"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/agreement"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/exchange"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates (proposalText AND smartContractContent) to (agreement OR exchange).</rdfs:comment>
        <rdfs:label xml:lang="en">Textually Encodes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/thresholdUsedByProcess -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/thresholdUsedByProcess">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposalPassThreshold"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/votingProcess"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of processHasThreshold: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Threshold Used By Process</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/tokenConformsToStandard -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/tokenConformsToStandard">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenStandard"/>
        <st:multiplicity xml:lang="en">0..* values per subject and 0..* subjects per object. No mandatory existence, global uniqueness or one-to-one constraint is asserted.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a modeled token resource to a token-standard specification that its definition or implementation conforms to, using the token type or identified-token granularity documented for the dataset.</rdfs:comment>
        <rdfs:label xml:lang="en">Token Conforms To Standard</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/tokensAreOwnedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/tokensAreOwnedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#hasTokenOwner"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Tokens are owned by. Relates token to tokenOwner.</rdfs:comment>
        <rdfs:label xml:lang="en">Tokens Are Owned By</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#hasTokenOwner"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/transactionOnBlockchain -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/transactionOnBlockchain">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchainTransaction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchain"/>
        <st:multiplicity xml:lang="en">blockchainTransaction → blockchain: 1..1; inverse normally 0..*.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">The chain on which this transaction occurs. Cross-chain operations are represented by linked transaction records.</rdfs:comment>
        <rdfs:label xml:lang="en">Transaction On Blockchain</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/transferRecipient -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/transferRecipient">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenTransferRecord"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/blockchainAccount"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/member"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">tokenTransferRecord → (blockchainAccount OR member OR organization): 1..1; inverse normally 0..*.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">The single recipient role recorded for this transfer line item.</rdfs:comment>
        <rdfs:label xml:lang="en">Transfer Recipient</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/transferRecordOfTransaction -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/transferRecordOfTransaction">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenTransferRecord"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/transaction"/>
        <st:multiplicity xml:lang="en">tokenTransferRecord → transaction: 1..1; inverse normally 0..*.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of hasTransferRecord: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Transfer Record Of Transaction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/transferSender -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/transferSender">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenTransferRecord"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/blockchainAccount"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/member"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">tokenTransferRecord → (blockchainAccount OR member OR organization): 1..1; inverse normally 0..*.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">The single sender role recorded for this transfer line item.</rdfs:comment>
        <rdfs:label xml:lang="en">Transfer Sender</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/transferToken -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/transferToken">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenTransferRecord"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <st:multiplicity xml:lang="en">tokenTransferRecord → token: 1..1; inverse normally 0..*.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">The single token resource quantified by this transfer line item.</rdfs:comment>
        <rdfs:label xml:lang="en">Transfer Token</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/transmitsExternalInformation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/transmitsExternalInformation">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/iotDevice"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/oracle"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/smartContractAccount"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#transmitsExternalInformation"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#transmitsExternalInformation"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Transmits external information. Relates (iotDevice OR oracle) to smartContractAccount.</rdfs:comment>
        <rdfs:label xml:lang="en">Transmits External Information</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#transmitsExternalInformation"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/triggers -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/triggers">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/contractTrigger"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/smartContractAccount"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Triggers. Relates contractTrigger to smartContractAccount.</rdfs:comment>
        <rdfs:label xml:lang="en">Triggers</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/voterTurnoutDeterminedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/voterTurnoutDeterminedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/voterTurnout"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/delegateVoter"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/proposal"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/reward"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Voter turnout influenced by. Relates voterTurnout to (delegateVoter OR proposal OR reward OR tokenOwner).</rdfs:comment>
        <rdfs:label xml:lang="en">Voter Turnout Influenced By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/votesOn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/votesOn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/proposal"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/proposalText"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates member to (proposal AND proposalText).</rdfs:comment>
        <rdfs:label xml:lang="en">Votes On</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/votingProcessForProposal -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/votingProcessForProposal">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isVotingProcessOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/votingProcess"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposal"/>
        <st:multiplicity xml:lang="en">votingProcess → proposal: 1..1; inverse normally 0..*.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">The one proposal being decided in this voting process or round.</rdfs:comment>
        <rdfs:label xml:lang="en">Voting Process For Proposal</rdfs:label>
    </owl:ObjectProperty>
    


