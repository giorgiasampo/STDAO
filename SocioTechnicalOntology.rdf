        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenDelegation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAO"/>
        <st:multiplicity xml:lang="en">tokenDelegation → DAO: 1..1; inverse normally 0..*.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">The one DAO in which the delegation applies.</rdfs:comment>
        <rdfs:label xml:lang="en">Delegation For DAO</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/delegationFrom -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/delegationFrom">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/hasOutgoingDelegation"/>
