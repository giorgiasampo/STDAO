        <rdfs:comment xml:lang="en">Can be called by. Relates (contractTrigger OR iotDevice OR oracle) to (oracleAccount OR smartContractAccount).</rdfs:comment>
        <rdfs:label xml:lang="en">Can Be Called By</rdfs:label>
    </owl:ObjectProperty>
    


