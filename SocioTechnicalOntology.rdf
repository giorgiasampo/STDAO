        <rdfs:label xml:lang="en">Is Targeted For Addition By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isTeamOfOrganization -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isTeamOfOrganization">
