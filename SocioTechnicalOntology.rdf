        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of changesStatusQuo: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Status Quo Is Changed By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/statusQuoIsKeptBy -->

