        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of hasTransactedToken: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Token In Transaction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isTokenOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isTokenOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/DAO"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#isSupportedBy"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Is token of. Relates token to (DAO OR organization).</rdfs:comment>
        <rdfs:label xml:lang="en">Is Token Of</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#isSupportedBy"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isTokenStandardImplementedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isTokenStandardImplementedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenStandard"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenContract"/>
        <st:multiplicity xml:lang="en">0..* values per subject and 0..* subjects per object. No mandatory existence, global uniqueness or one-to-one constraint is asserted.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a token-standard specification to a token-contract account whose implementation implements it. This is the exact inverse of implementsTokenStandard.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Token Standard Implemented By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isTreasuryAsset -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isTreasuryAsset">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/multiSignatureWallet"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Is treasury asset. Relates token to multiSignatureWallet.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Treasury Asset</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isTreasuryOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isTreasuryOf">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/commonResources"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/multiSignatureWallet"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/DAO"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#usedByDAO"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Relates (commonResources OR multiSignatureWallet) to (DAO OR organization).</rdfs:comment>
        <rdfs:label xml:lang="en">Is Treasury Of</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#usedByDAO"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isTriggeredBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isTriggeredBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/triggers"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/smartContractAccount"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/contractTrigger"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Is triggered by. Relates smartContractAccount to contractTrigger.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Triggered By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isUsedToComputeHashValue -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isUsedToComputeHashValue">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/hashFunction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/hashValue"/>
        <st:multiplicity xml:lang="en">0..* values per subject and 0..* subjects per object. No mandatory existence, global uniqueness or one-to-one constraint is asserted.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a specified hash function to a recorded hash-output resource computed using that function. This is the exact inverse of hashComputedUsing.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Used To Compute Hash Value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isVotedOn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isVotedOn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/votesOn"/>
        <rdfs:domain>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/proposal"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/proposalText"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates (proposal AND proposalText) to member.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Voted On</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isVotedOnThrough -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isVotedOnThrough">
        <rdfs:domain>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/proposal"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/proposalText"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/governanceToken"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#hasVotingToken"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Relates (proposal AND proposalText) to governanceToken.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Voted On Through</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#hasVotingToken"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isVotingBehaviorOfMember -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isVotingBehaviorOfMember">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/memberHasVotingBehavior"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/votesResult"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/directVoter"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Is voting behavior of member. Relates votesResult to directVoter.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Voting Behavior Of Member</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isVotingOutcomeOfProposal -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isVotingOutcomeOfProposal">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposalHasVotingOutcome"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/voteParticipation"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/proposal"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/proposalText"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
