        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <st:multiplicity xml:lang="en">0..* values per subject and 0..* subjects per object. No mandatory existence, global uniqueness or one-to-one constraint is asserted.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a token-standard specification to a modeled token resource asserted to conform to it. This is the exact inverse of tokenConformsToStandard.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Standard For Conforming Token</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isStrategyOfMember -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isStrategyOfMember">
