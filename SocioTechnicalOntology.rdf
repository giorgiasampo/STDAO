<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/gisa/STDAO#"
     xml:base="http://www.semanticweb.org/gisa/STDAO"
     xmlns:st="http://www.semanticweb.org/gisa/STDAO/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.semanticweb.org/gisa/STDAO">
        <owl:versionIRI rdf:resource="http://www.semanticweb.org/gisa/STDAO/1.1-review-2026-10-21"/>
        <dcterms:title xml:lang="en">Socio-Technical DAO Ontology</dcterms:title>
        <rdfs:comment xml:lang="en">A socio-technical ontology of decentralized autonomous organizations (DAOs), covering technical artifacts, governance arrangements and organizational practices.</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/source -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/multiplicity -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/multiplicity">
        <rdfs:comment xml:lang="en">Human-readable cardinality of relation values in their stated class or record context.</rdfs:comment>
        <rdfs:label xml:lang="en">Multiplicity</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/relationArity -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/relationArity">
        <rdfs:comment xml:lang="en">Number of arguments of a binary predicate, or roles of a reified n-ary relation.</rdfs:comment>
        <rdfs:label xml:lang="en">Relation Arity</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/sourceEntity -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/sourceEntity">
        <rdfs:comment xml:lang="en">IRI of a related entity in the Web3 DAO ontology or its referenced vocabulary. This annotation does not assert logical equivalence.</rdfs:comment>
        <rdfs:label xml:lang="en">Source Entity</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/sourceOntology -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/sourceOntology">
        <rdfs:comment xml:lang="en">IRI of the source ontology associated with the annotated element.</rdfs:comment>
        <rdfs:label xml:lang="en">Source Ontology</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/sourceVersion -->

    <owl:AnnotationProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/sourceVersion">
        <rdfs:comment xml:lang="en">Version IRI of the referenced source ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">Source Version</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/gisa/STDAO/DAOCanInclude -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/DAOCanInclude">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/canBeIncludedInDAO"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAO"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/oracleAccount"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/smartContractAccount"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Dao can include. Relates DAO to (oracleAccount OR smartContractAccount).</rdfs:comment>
        <rdfs:label xml:lang="en">DAO Can Include</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/DAOIsInstantiationOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/DAOIsInstantiationOf">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isInstantiatedIn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAO"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/organization"/>
        <st:multiplicity xml:lang="en">DAO → organization: 1..*; inverse normally 0..*.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Dao is instantiation of. Relates DAO to organization.</rdfs:comment>
        <rdfs:label xml:lang="en">DAO Is Instantiation Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/accountOnBlockchain -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/accountOnBlockchain">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/hasBlockchainAccount"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchainAccount"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchain"/>
        <st:multiplicity xml:lang="en">blockchainAccount → blockchain: 1..1; inverse normally 0..*.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">The chain context for this account identifier. Different chains use separate account individuals in this profile.</rdfs:comment>
        <rdfs:label xml:lang="en">Account On Blockchain</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/acquiresTokenFrom -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/acquiresTokenFrom">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/sellsTokenTo"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Acquires token from. Relates tokenOwner to tokenOwner.</rdfs:comment>
        <rdfs:label xml:lang="en">Acquires Token From</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/actsHonestlyInGovernance -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/actsHonestlyInGovernance">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/hasHonestConductByMember"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAOGovernance"/>
        <st:multiplicity xml:lang="en">0..* values per subject and 0..* subjects per object. The relation is optional and many-to-many.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a member to a DAO-governance arrangement or episode in which that member&apos;s conduct is characterized as honest under the applicable criteria. Honest and strategic conduct may coexist in the same context.</rdfs:comment>
        <rdfs:label xml:lang="en">Acts Honestly In Governance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/actsStrategicallyInGovernance -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/actsStrategicallyInGovernance">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/hasStrategicConductByMember"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organizationalGoal"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organizationalStatus"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/reward"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">0..* values per subject and 0..* subjects per object. The relation is optional and many-to-many.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a member to a DAO-governance arrangement or episode in which that member&apos;s conduct is characterized as strategic, such as choosing actions in light of expected responses or objectives. Strategic conduct may also be honest.</rdfs:comment>
        <rdfs:label xml:lang="en">Acts Strategically In Governance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/addsBlock -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/addsBlock">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isAddedBy"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/miner"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/block"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of isAddedBy: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Adds Block</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/aimsToAdd -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/aimsToAdd">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isTargetedForAdditionBy"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/miner"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/block"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Aims to add. Relates miner to block.</rdfs:comment>
        <rdfs:label xml:lang="en">Aims To Add</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/areKnownBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/areKnownBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isAwareOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO:governanceIntermediationLayer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/directVoter"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Are known by. Relates governanceIntermediationLayer to directVoter.</rdfs:comment>
        <rdfs:label xml:lang="en">Are Known By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/arePartOfOrganization -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/arePartOfOrganization">
        <owl:equivalentProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/isMember"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isComposedOfMembers"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/organization"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Are part of organization. Relates member to organization.</rdfs:comment>
        <rdfs:label xml:lang="en">Are Part Of Organization</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/areTextuallyEncodedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/areTextuallyEncodedIn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/textuallyEncodes"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/agreement"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/exchange"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/proposalText"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/smartContractContent"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates (agreement OR exchange) to (proposalText AND smartContractContent).</rdfs:comment>
        <rdfs:label xml:lang="en">Are Textually Encoded In</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/assignsDelegatedTokens -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/assignsDelegatedTokens">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isTokenDelegatedBy"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Connects an assigning token owner to a delegated token. The receiving delegate and DAO context belong in a tokenDelegation record.</rdfs:comment>
        <rdfs:label xml:lang="en">Assigns Delegated Tokens</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/ballotBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/ballotBy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/hasBallot"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/ballot"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
        <st:multiplicity xml:lang="en">ballot → member: 1..1; inverse normally 0..*.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#votesOfEOA"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">The one member casting this ballot.</rdfs:comment>
        <rdfs:label xml:lang="en">Ballot By</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#votesOfEOA"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/ballotInProcess -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/ballotInProcess">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/processHasBallot"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/ballot"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/votingProcess"/>
        <st:multiplicity xml:lang="en">ballot → votingProcess: 1..1; inverse normally 0..*.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#votesOfProposal"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">The one process or round in which this ballot is cast.</rdfs:comment>
        <rdfs:label xml:lang="en">Ballot In Process</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#votesOfProposal"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/baseToken -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/baseToken">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/hasBaseRateObservation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/exchangeRateObservation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <st:multiplicity xml:lang="en">exchangeRateObservation → token: 1..1; inverse normally 0..*.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">The token whose one unit is priced by this exchange-rate observation.</rdfs:comment>
        <rdfs:label xml:lang="en">Base Token</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/belongsTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/belongsTo">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/hasAccount"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/externallyOwnedAccount"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/member"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#belongsTo"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#belongsTo"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Belongs to. Relates externallyOwnedAccount to (member OR organization).</rdfs:comment>
        <rdfs:label xml:lang="en">Belongs To</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#belongsTo"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/blockContains -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/blockContains">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isContentOfBlock"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/block"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/blockContent"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/blockHeader"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a blockchain block to information recorded as part of its contents, including a block header, recorded hash values, and other payload or metadata represented as blockContent. Use blockRecordsTransaction to identify the blockchain transaction events recorded in a block; information containment does not by itself identify a token-bearing exchange.</rdfs:comment>
        <rdfs:label xml:lang="en">Block Contains</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/blockHasHeader -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/blockHasHeader">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockContains"/>
