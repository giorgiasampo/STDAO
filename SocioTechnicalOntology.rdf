        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Contributes to voter turnout. Relates (delegateVoter OR proposal OR reward OR tokenOwner) to voterTurnout.</rdfs:comment>
        <rdfs:label xml:lang="en">Contributes To Voter Turnout</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/determinesVotingResult -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/determinesVotingResult">
