        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/block"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockHeader"/>
        <st:multiplicity xml:lang="en">0..* values per subject and 0..* subjects per object. No mandatory existence, global uniqueness or one-to-one constraint is asserted.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a block to a header information resource recorded as part of that block.</rdfs:comment>
        <rdfs:label xml:lang="en">Block Has Header</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/blockRecordsTransaction -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/blockRecordsTransaction">
