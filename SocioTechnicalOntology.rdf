    <!-- http://www.semanticweb.org/gisa/STDAO/accountAddress -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/accountAddress">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchainAccount"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <st:multiplicity xml:lang="en">blockchainAccount → xsd:string: 0..1.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Chain-specific account identifier. It is not asserted to be a globally unique key across chains.</rdfs:comment>
        <rdfs:label xml:lang="en">Account Address</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/blockchainID -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/blockchainID">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchain"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#blockchainId"/>
        <st:multiplicity xml:lang="en">Default 0..* literal values; no universal maximum asserted. A state/observation profile may constrain this attribute further.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#blockchainId"/>
