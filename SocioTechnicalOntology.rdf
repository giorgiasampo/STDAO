            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <st:multiplicity xml:lang="en">exchangeRateObservation → xsd:dateTime: 1..1.</st:multiplicity>
        <st:multiplicity xml:lang="en">tokenHolding → xsd:dateTime: 1..1.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">The observation time for a holding or exchange-rate value.</rdfs:comment>
        <rdfs:label xml:lang="en">Observed At</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/password -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/password">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/web3WalletAccount"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <st:multiplicity xml:lang="en">Default 0..* literal values; no universal maximum asserted. A state/observation profile may constrain this attribute further.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#password"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Password: a literal-valued attribute of web3WalletAccount, with range xsd:string. Time-sensitive values require a consistent state or observation context.</rdfs:comment>
        <rdfs:label xml:lang="en">Password</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#password"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/privateKey -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/privateKey">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/web3WalletAccount"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <st:multiplicity xml:lang="en">Default 0..* literal values; no universal maximum asserted. A state/observation profile may constrain this attribute further.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#privateKey"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Private key: a literal-valued attribute of web3WalletAccount, with range xsd:string. Time-sensitive values require a consistent state or observation context.</rdfs:comment>
        <rdfs:label xml:lang="en">Private Key</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#privateKey"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/processed -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/processed">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#processed"/>
        <st:multiplicity xml:lang="en">proposal → xsd:boolean: 0..1.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#processed"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Processed: a literal-valued attribute of proposal, with range xsd:boolean. Time-sensitive values require a consistent state or observation context.</rdfs:comment>
        <rdfs:label xml:lang="en">Processed</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#processed"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/processedAt -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/processedAt">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#processedAt"/>
        <st:multiplicity xml:lang="en">proposal → xsd:dateTime: 0..1.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#processedAt"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Processed at: a literal-valued attribute of proposal, with range xsd:dateTime. Time-sensitive values require a consistent state or observation context.</rdfs:comment>
        <rdfs:label xml:lang="en">Processed At</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#processedAt"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/rateValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/rateValue">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/exchangeRateObservation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <st:multiplicity xml:lang="en">exchangeRateObservation → xsd:decimal: 1..1.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Quote-token units per one base-token unit at observedAt. Strictly positive.</rdfs:comment>
        <rdfs:label xml:lang="en">Rate Value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/startDate -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/startDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposal"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <st:multiplicity xml:lang="en">proposal → xsd:dateTime: 0..1.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#startDate"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Start date: a literal-valued attribute of proposal, with range xsd:dateTime. Time-sensitive values require a consistent state or observation context.</rdfs:comment>
        <rdfs:label xml:lang="en">Start Date</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#startDate"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/textContent -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/textContent">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/blockContent"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/proposalText"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/whitepaperText"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <st:multiplicity xml:lang="en">Default 0..* literal values; no universal maximum asserted. A state/observation profile may constrain this attribute further.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#text"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Text content: a literal-valued attribute of (blockContent OR proposalText OR whitepaperText), with range xsd:string. Time-sensitive values require a consistent state or observation context.</rdfs:comment>
        <rdfs:label xml:lang="en">Text Content</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#text"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/tokenAmount -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/tokenAmount">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/tokenDelegation"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/tokenHolding"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/tokenTransferRecord"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <st:multiplicity xml:lang="en">tokenDelegation → xsd:decimal: 0..1.</st:multiplicity>
        <st:multiplicity xml:lang="en">tokenHolding → xsd:decimal: 1..1.</st:multiplicity>
        <st:multiplicity xml:lang="en">tokenTransferRecord → xsd:decimal: 1..1.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#holderBalance"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A quantity of the single token resource named in the same record. Measured in token units, not number of RDF token nodes. Strictly positive when supplied.</rdfs:comment>
        <rdfs:label xml:lang="en">Token Amount</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#holderBalance"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/tokenID -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/tokenID">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#tokenId"/>
        <st:multiplicity xml:lang="en">Default 0..* literal values; no universal maximum asserted. A state/observation profile may constrain this attribute further.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#tokenId"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Token id: a literal-valued attribute of token, with range xsd:string. Time-sensitive values require a consistent state or observation context.</rdfs:comment>
        <rdfs:label xml:lang="en">Token ID</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#tokenId"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/transactionHash -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/transactionHash">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchainTransaction"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <st:multiplicity xml:lang="en">blockchainTransaction → xsd:string: 0..1.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Transaction identifier interpreted together with its chain context. It is not declared a globally unique OWL key.</rdfs:comment>
        <rdfs:label xml:lang="en">Transaction Hash</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/validFrom -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/validFrom">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/membershipRecord"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/tokenDelegation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <st:multiplicity xml:lang="en">membershipRecord → xsd:dateTime: 0..1.</st:multiplicity>
        <st:multiplicity xml:lang="en">tokenDelegation → xsd:dateTime: 0..1.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Optional start of validity for the membership or delegation record.</rdfs:comment>
        <rdfs:label xml:lang="en">Valid From</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/validUntil -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/validUntil">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/membershipRecord"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/tokenDelegation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <st:multiplicity xml:lang="en">membershipRecord → xsd:dateTime: 0..1.</st:multiplicity>
        <st:multiplicity xml:lang="en">tokenDelegation → xsd:dateTime: 0..1.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Optional end of validity for the membership or delegation record.</rdfs:comment>
        <rdfs:label xml:lang="en">Valid Until</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/voteChoice -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/voteChoice">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/ballot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <st:multiplicity xml:lang="en">ballot → xsd:string: 1..1.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#hasDecision"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">The recorded voting option or encoded choice. Allowed choices are defined by the voting scheme.</rdfs:comment>
        <rdfs:label xml:lang="en">Vote Choice</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#hasDecision"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/voteWeight -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/voteWeight">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/ballot"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <st:multiplicity xml:lang="en">ballot → xsd:decimal: 0..1.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Optional nonnegative weight of this ballot under its voting scheme.</rdfs:comment>
        <rdfs:label xml:lang="en">Vote Weight</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/gisa/STDAO:blockchainGovernance -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO:blockchainGovernance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO:governanceIntermediationLayer"/>
        <rdfs:comment xml:lang="en">Rules and mechanisms organizing blockchain protocol decisions and consensus.</rdfs:comment>
        <rdfs:label xml:lang="en">Blockchain Governance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO:governanceIntermediationLayer -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO:governanceIntermediationLayer">
        <rdfs:comment>Governance intermediation layer connects  technical possibilities to collective decision-making through rules, decision rights, voting, incentives, coordination, and reputation.</rdfs:comment>
        <rdfs:label xml:lang="en">Governance Intermediation Layer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO:proposalParticipation -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO:proposalParticipation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalStatus"/>
        <rdfs:comment xml:lang="en">An organizational-status category describing participation in proposal activity, including participation beyond voting.</rdfs:comment>
        <rdfs:label xml:lang="en">Proposal Participation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/CEX -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/CEX">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/exchangePlatform"/>
        <rdfs:comment xml:lang="en">An exchange platform operated through a centralized coordinating entity.</rdfs:comment>
        <rdfs:label xml:lang="en">CEX</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/DAO -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/DAO">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAOIsInstantiationOf"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/organization"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/hasDAOMember"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#DAO"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#DAO"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">The technical instantiation of a decentralized autonomous organization in this three-layer model. Its organizational manifestation is connected by DAOIsInstantiationOf; membership is connected by hasDAOMember.</rdfs:comment>
        <rdfs:label xml:lang="en">DAO</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#DAO"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/DAOGovernance -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/DAOGovernance">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO:governanceIntermediationLayer"/>
        <rdfs:comment xml:lang="en">Rules, processes and arrangements through which collective decisions are organized in a DAO.</rdfs:comment>
        <rdfs:label xml:lang="en">DAO Governance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/DAOPlatform -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/DAOPlatform">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchainPlatform"/>
        <rdfs:comment xml:lang="en">A blockchain platform supporting the creation or operation of DAOs.</rdfs:comment>
        <rdfs:label xml:lang="en">DAO Platform</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/DAppPlatform -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/DAppPlatform">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchainPlatform"/>
        <rdfs:comment xml:lang="en">A blockchain platform supporting decentralized applications.</rdfs:comment>
        <rdfs:label xml:lang="en">DApp Platform</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/DEX -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/DEX">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/exchangePlatform"/>
        <rdfs:comment xml:lang="en">An exchange platform whose trading or settlement functions use decentralized mechanisms.</rdfs:comment>
        <rdfs:label xml:lang="en">DEX</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/Dapp -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/Dapp">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Dapp"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Dapp"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A decentralized application whose operation depends on distributed technical infrastructure and application logic.</rdfs:comment>
        <rdfs:label xml:lang="en">Dapp</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Dapp"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/ICO -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/ICO">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenDistribution"/>
        <rdfs:comment xml:lang="en">An initial coin offering, modeled here as a mechanism of token distribution.</rdfs:comment>
        <rdfs:label xml:lang="en">ICO</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/PoS -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/PoS">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO:blockchainGovernance"/>
        <rdfs:comment xml:lang="en">A proof-of-stake consensus arrangement in which stake participates in the selection or accountability of block validators.</rdfs:comment>
        <rdfs:label xml:lang="en">Proof Of Stake</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/PoW -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/PoW">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO:blockchainGovernance"/>
        <rdfs:comment xml:lang="en">A proof-of-work consensus arrangement in which computational work participates in block production or chain selection.</rdfs:comment>
        <rdfs:label xml:lang="en">Proof Of Work</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/agreement -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/agreement">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/interactions"/>
        <rdfs:comment xml:lang="en">An agreement between parties within organizational interactions. It may be recorded in a legal contract or other document.</rdfs:comment>
        <rdfs:label xml:lang="en">Agreement</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/airdrop -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/airdrop">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenDistribution"/>
        <rdfs:comment xml:lang="en">A token distribution mechanism that allocates tokens to recipients under stated eligibility rules.</rdfs:comment>
        <rdfs:label xml:lang="en">Airdrop</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/attack -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/attack">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/securityRisk"/>
        <rdfs:comment xml:lang="en">An action or attempted action directed at compromising a system, asset or governance process.</rdfs:comment>
        <rdfs:label xml:lang="en">Attack</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/ballot -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/ballot">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAOGovernance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/ballotBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/ballotInProcess"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/votingProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/voteChoice"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/castAt"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/voteWeight"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Votes"/>
        <st:relationArity xml:lang="en">Reified n-ary relation: voter, voting process, choice; optional weight and time.</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Votes"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">One recorded voting act by one member in one voting process, with one choice literal. A member may cast multiple ballots across processes; policies about recasting or multiple options belong to the voting scheme.</rdfs:comment>
        <rdfs:label xml:lang="en">Ballot</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Votes"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/block -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/block">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <rdfs:comment xml:lang="en">A ledger unit grouping recorded blockchain information.</rdfs:comment>
        <rdfs:label xml:lang="en">Block</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/blockContent -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/blockContent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <rdfs:comment xml:lang="en">An information resource recorded within a blockchain block, including a header, a recorded hash output, or other payload or metadata represented for the relevant protocol. Transaction events are represented by blockchainTransaction and linked to blocks through blockRecordsTransaction.</rdfs:comment>
        <rdfs:label xml:lang="en">Block Content</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/blockHeader -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/blockHeader">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockContent"/>
        <rdfs:comment xml:lang="en">The metadata portion of a block used to identify or verify the block and its relation to the ledger.</rdfs:comment>
        <rdfs:label xml:lang="en">Block Header</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/blockchain -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/blockchain">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Blockchain"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Blockchain"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A distributed ledger infrastructure organized through linked blocks and a protocol for agreeing on recorded state.</rdfs:comment>
        <rdfs:label xml:lang="en">Blockchain</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Blockchain"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/blockchainAccount -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/blockchainAccount">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/accountOnBlockchain"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchain"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/accountAddress"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/FOAF#OnlineAccount"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">An account identified within a blockchain network. Externally controlled, contract and wallet account specializations share this superclass. No assumption about one human owner or one private key is imposed.</rdfs:comment>
        <rdfs:label xml:lang="en">Blockchain Account</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/FOAF#OnlineAccount"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/blockchainPlatform -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/blockchainPlatform">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/platform"/>
        <rdfs:comment xml:lang="en">A platform providing or using blockchain infrastructure for applications, assets or governance operations.</rdfs:comment>
        <rdfs:label xml:lang="en">Blockchain Platform</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/blockchainTransaction -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/blockchainTransaction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/transactionOnBlockchain"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchain"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/transactionHash"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A blockchain state-change transaction, including contract calls and deployments. Token movement is optional for this broad class. The transaction class represents token-bearing exchanges.</rdfs:comment>
        <rdfs:label xml:lang="en">Blockchain Transaction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/centralizationRisk -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/centralizationRisk">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/securityRisk"/>
        <rdfs:comment xml:lang="en">A risk arising from concentration of control, influence or resources.</rdfs:comment>
        <rdfs:label xml:lang="en">Centralization Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/commonResources -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/commonResources">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalManifestationLayer"/>
        <rdfs:comment xml:lang="en">Resources available for collective organizational purposes, including treasury assets and revenues.</rdfs:comment>
        <rdfs:label xml:lang="en">Common Resources</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/conflict -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/conflict">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/interactions"/>
        <rdfs:comment xml:lang="en">A disagreement or incompatible claim arising among participants or concerning organizational activity.</rdfs:comment>
        <rdfs:label xml:lang="en">Conflict</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/conflictResolutionMechanism -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/conflictResolutionMechanism">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAOGovernance"/>
        <rdfs:comment xml:lang="en">A governance arrangement for addressing disputes and resolving incompatible claims.</rdfs:comment>
        <rdfs:label xml:lang="en">Conflict Resolution Mechanism</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/contract -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/contract">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/legalAspects"/>
        <rdfs:comment xml:lang="en">A legal agreement or legally meaningful instrument, distinguished here from its smart-contract code representation.</rdfs:comment>
        <rdfs:label xml:lang="en">Contract</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/contractTrigger -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/contractTrigger">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <rdfs:comment xml:lang="en">An event, condition or invocation that activates smart-contract behavior.</rdfs:comment>
        <rdfs:label xml:lang="en">Contract Trigger</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/convictionVoting -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/convictionVoting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/votingScheme"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/gisa/STDAO/directVoting"/>
        <rdfs:comment xml:lang="en">A voting scheme in which sustained support over time contributes to the decision signal. Specific accumulation and threshold rules belong to the scheme instance.</rdfs:comment>
        <rdfs:label xml:lang="en">Conviction Voting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/coreTeam -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/coreTeam">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/team"/>
        <rdfs:comment xml:lang="en">A team carrying central coordinating or foundational responsibilities within the organization.</rdfs:comment>
        <rdfs:label xml:lang="en">Core Team</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/decentralizedJustice -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/decentralizedJustice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/conflictResolutionMechanism"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/legalAspects"/>
        <rdfs:comment xml:lang="en">A dispute-resolution arrangement using decentralized governance mechanisms. It is both a legal and a governance concept.</rdfs:comment>
        <rdfs:label xml:lang="en">Decentralized Justice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/decisionalBottlenecks -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/decisionalBottlenecks">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/centralizationRisk"/>
        <rdfs:comment xml:lang="en">Concentrated decision requirements that limit the flow or timeliness of organizational decisions.</rdfs:comment>
        <rdfs:label xml:lang="en">Decisional Bottlenecks</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/delegateVoter -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/delegateVoter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <rdfs:comment xml:lang="en">A token-owner role that receives delegated voting authority. Particular delegations are recorded with their DAO context.</rdfs:comment>
        <rdfs:label xml:lang="en">Delegate Voter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/deliberationPlatform -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/deliberationPlatform">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/platform"/>
        <rdfs:comment xml:lang="en">A platform supporting discussion and deliberation among participants.</rdfs:comment>
        <rdfs:label xml:lang="en">Deliberation Platform</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/directVoter -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/directVoter">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <rdfs:comment xml:lang="en">A token-owner role that participates in governance directly. This role is not automatically assigned to every member.</rdfs:comment>
        <rdfs:label xml:lang="en">Direct Voter</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/directVoting -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/directVoting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/votingScheme"/>
        <rdfs:comment xml:lang="en">A voting scheme in which participants cast their own votes directly.</rdfs:comment>
        <rdfs:label xml:lang="en">Direct Voting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/discussion -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/discussion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/interactions"/>
        <rdfs:comment xml:lang="en">An interaction through which participants exchange views, deliberate or develop proposals.</rdfs:comment>
        <rdfs:label xml:lang="en">Discussion</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/documents -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/documents">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAOGovernance"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalManifestationLayer"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/FOAF#Document"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Recorded information artifacts used in governance and organizational activity.</rdfs:comment>
        <rdfs:label xml:lang="en">Documents</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/FOAF#Document"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/economic -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/economic">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/reward"/>
        <rdfs:comment xml:lang="en">A reward offering economic value or material benefit.</rdfs:comment>
        <rdfs:label xml:lang="en">Economic Reward</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/electionProposal -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/electionProposal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposal"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Elections"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A proposal concerned with selecting people or roles for governance or organizational responsibilities.</rdfs:comment>
        <rdfs:label xml:lang="en">Election Proposal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Elections"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/exchange -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/exchange">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/interactions"/>
        <rdfs:comment xml:lang="en">An interaction involving a transfer or reciprocal arrangement between parties.</rdfs:comment>
        <rdfs:label xml:lang="en">Exchange</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/exchangePlatform -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/exchangePlatform">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/platform"/>
        <rdfs:comment xml:lang="en">A platform supporting exchange of assets or other modeled resources.</rdfs:comment>
        <rdfs:label xml:lang="en">Exchange Platform</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/exchangeRateObservation -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/exchangeRateObservation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalStatus"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/baseToken"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/quoteToken"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/rateValue"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</xsd:minExclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/observedAt"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/rateValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <st:relationArity xml:lang="en">Reified n-ary relation: base token, quote token, numeric rate, observation time.</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#cryptoPrice"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">An observation of the strictly positive price of one unit of a base token in units of a quote token at one observation time.</rdfs:comment>
        <rdfs:label xml:lang="en">Exchange Rate Observation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#cryptoPrice"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/exploitContractVulnerabilityAttack -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/exploitContractVulnerabilityAttack">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/attack"/>
        <rdfs:comment xml:lang="en">An attack exploiting a defect or unintended behavior in smart-contract logic.</rdfs:comment>
        <rdfs:label xml:lang="en">Exploit Contract Vulnerability Attack</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/externallyOwnedAccount -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/externallyOwnedAccount">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchainAccount"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#EOA"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#EOA"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A blockchain account controlled through external authorization, typically a cryptographic key. This class is a specialization of blockchainAccount, not a superclass for all contract accounts.</rdfs:comment>
        <rdfs:label xml:lang="en">Externally Owned Account</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#EOA"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/formalLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/formalLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/language"/>
        <rdfs:comment xml:lang="en">A language with explicitly specified syntax and interpretation used to express code or formal information.</rdfs:comment>
        <rdfs:label xml:lang="en">Formal Language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/functionalTeam -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/functionalTeam">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/team"/>
        <rdfs:comment xml:lang="en">A team organized around a particular organizational function.</rdfs:comment>
        <rdfs:label xml:lang="en">Functional Team</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/fundAllocationContract -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/fundAllocationContract">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/smartContractAccount"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#FundAllocationContract"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#FundAllocationContract"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A smart contract account implementing allocation or disbursement of DAO funds.</rdfs:comment>
        <rdfs:label xml:lang="en">Fund Allocation Contract</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#FundAllocationContract"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/governanceProposal -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/governanceProposal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposal"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Others"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A proposal concerning governance arrangements, rules or organizational status.</rdfs:comment>
        <rdfs:label xml:lang="en">Governance Proposal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Others"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/governanceToken -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/governanceToken">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <rdfs:comment xml:lang="en">A token whose associated rights or weighting participate in governance. Governance function alone does not determine its legal classification or transferability.</rdfs:comment>
        <rdfs:label xml:lang="en">Governance Token</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hashFunction -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/hashFunction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <rdfs:comment xml:lang="en">A specified computational function or algorithm used to produce hash outputs from input data.</rdfs:comment>
        <rdfs:label xml:lang="en">Hash Function</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hashValue -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/hashValue">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockContent"/>
        <rdfs:comment xml:lang="en">A hash output represented as part of recorded blockchain information.</rdfs:comment>
        <rdfs:label xml:lang="en">Hash Value</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/holographicVoting -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/holographicVoting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/votingScheme"/>
        <rdfs:comment xml:lang="en">A governance scheme identified as holographic voting. The precise incentive, participation and decision rules must be specified for the scheme instance.</rdfs:comment>
        <rdfs:label xml:lang="en">Holographic Voting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/identityManagementSystem -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/identityManagementSystem">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <rdfs:comment xml:lang="en">A system that represents, verifies or manages participant identities and credentials.</rdfs:comment>
        <rdfs:label xml:lang="en">Identity Management System</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/interactions -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/interactions">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalManifestationLayer"/>
        <rdfs:comment xml:lang="en">Organizational activities and relationships involving participants, such as discussion, agreement, exchange or conflict.</rdfs:comment>
        <rdfs:label xml:lang="en">Interactions</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/investmentProposal -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/investmentProposal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposal"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Financial"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A proposal concerning investment of resources or assets.</rdfs:comment>
        <rdfs:label xml:lang="en">Investment Proposal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Financial"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/investmentRevenues -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/investmentRevenues">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/commonResources"/>
        <rdfs:comment xml:lang="en">Returns generated by investments and available as organizational resources.</rdfs:comment>
        <rdfs:label xml:lang="en">Investment Revenues</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/iotDevice -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/iotDevice">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <rdfs:comment xml:lang="en">An internet-connected physical device that can supply information or interact with a technical system.</rdfs:comment>
        <rdfs:label xml:lang="en">Iot Device</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/language -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/language">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <rdfs:comment xml:lang="en">A natural or formal system of expression used by the modeled information artifacts.</rdfs:comment>
        <rdfs:label xml:lang="en">Language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/law -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/law">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/legalFramework"/>
        <rdfs:comment xml:lang="en">A legal rule or body of rules within the applicable legal framework. It is a cross-cutting legal concept.</rdfs:comment>
        <rdfs:label xml:lang="en">Law</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/legalAspects -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/legalAspects">
        <rdfs:comment>Cross-cutting legal aspects concerning all other layers.</rdfs:comment>
        <rdfs:label xml:lang="en">Legal Aspects</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/legalFramework -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/legalFramework">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/legalAspects"/>
        <rdfs:comment xml:lang="en">A legal or regulatory context relevant to organizational activity, agreements or technical implementation.</rdfs:comment>
        <rdfs:label xml:lang="en">Legal Framework</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/member -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/member">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalManifestationLayer"/>
        <rdfs:comment xml:lang="en">A participant in the modeled organizational setting. Membership in a particular DAO is expressed by hasDAOMember or a membershipRecord.</rdfs:comment>
        <rdfs:label xml:lang="en">Member</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/membershipContract -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/membershipContract">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/smartContractAccount"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#MembershipContract"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#MembershipContract"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A smart contract account implementing membership conditions or operations, potentially including subscriptions or access rights.</rdfs:comment>
        <rdfs:label xml:lang="en">Membership Contract</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#MembershipContract"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/membershipRecord -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/membershipRecord">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalManifestationLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/membershipDAO"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/membershipMember"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/validFrom"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/validUntil"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#IsMember"/>
        <st:relationArity xml:lang="en">Reified n-ary relation: member, DAO; optional validity interval.</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#IsMember"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">One membership relationship between one member and one DAO, optionally qualified by validity dates. It records organizational context without collapsing the technical DAO into the organization class.</rdfs:comment>
        <rdfs:label xml:lang="en">Membership Record</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#IsMember"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/miner -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/miner">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
        <rdfs:comment xml:lang="en">A participant performing mining in the modeled setting.</rdfs:comment>
        <rdfs:label xml:lang="en">Miner</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/multiSignatureWallet -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/multiSignatureWallet">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/web3WalletAccount"/>
        <rdfs:comment xml:lang="en">A wallet account whose authorization policy involves multiple approvals or signatures. The precise threshold and implementation are instance-specific.</rdfs:comment>
        <rdfs:label xml:lang="en">Multi Signature Wallet</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/naturalLanguage -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/naturalLanguage">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/language"/>
        <rdfs:comment xml:lang="en">A human language used in legal, proposal or explanatory texts.</rdfs:comment>
        <rdfs:label xml:lang="en">Natural Language</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/oracle -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/oracle">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Oracle"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Oracle"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A service or mechanism supplying external information to a blockchain or smart-contract system.</rdfs:comment>
        <rdfs:label xml:lang="en">Oracle</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Oracle"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/oracleAccount -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/oracleAccount">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchainAccount"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#OracleContract"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#OracleContract"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A blockchain account acting for an oracle or oracle service. Its implementation may use external or contract-based control.</rdfs:comment>
        <rdfs:label xml:lang="en">Oracle Account</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#OracleContract"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/organization -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/organization">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalManifestationLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/hasNumberMembers"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/FOAF#Organization"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">An organized collective in the organizational manifestation layer. A technical DAO can instantiate an organization without being made its subclass.</rdfs:comment>
        <rdfs:label xml:lang="en">Organization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/FOAF#Organization"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/organizationalGoal -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/organizationalGoal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalManifestationLayer"/>
        <rdfs:comment xml:lang="en">A purpose or objective pursued by an organization.</rdfs:comment>
        <rdfs:label xml:lang="en">Organizational Goal</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/organizationalManifestationLayer -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/organizationalManifestationLayer">
        <rdfs:comment>Organizational manifestation layer concerns organizational practices and outcomes, including participation, membership, collective action, teams, and organizational purpose.</rdfs:comment>
        <rdfs:label xml:lang="en">Organizational Manifestation Layer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/organizationalStatus -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/organizationalStatus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAOGovernance"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalManifestationLayer"/>
        <rdfs:comment xml:lang="en">A state or configuration of the organization relevant to governance. It spans the governance and organizational layers.</rdfs:comment>
        <rdfs:label xml:lang="en">Organizational Status</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/pbft -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/pbft">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO:blockchainGovernance"/>
        <rdfs:comment xml:lang="en">A practical Byzantine fault tolerance consensus arrangement in the blockchain-governance part of this model.</rdfs:comment>
        <rdfs:label xml:lang="en">Practical Byzantine Fault Tolerance</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/personalWallet -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/personalWallet">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/web3WalletAccount"/>
        <rdfs:comment xml:lang="en">A wallet account used by a member for personal asset management or participation.</rdfs:comment>
        <rdfs:label xml:lang="en">Personal Wallet</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/platform -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/platform">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <rdfs:comment xml:lang="en">A technical environment supporting interaction, execution, exchange or other services.</rdfs:comment>
        <rdfs:label xml:lang="en">Platform</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/powerCentralization -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/powerCentralization">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/centralizationRisk"/>
        <rdfs:comment xml:lang="en">Concentration of decision influence or control within the modeled organizational or technical system.</rdfs:comment>
        <rdfs:label xml:lang="en">Power Centralization</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/productOriented -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/productOriented">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalGoal"/>
        <rdfs:comment xml:lang="en">An organizational goal emphasizing the development or provision of products.</rdfs:comment>
        <rdfs:label xml:lang="en">Product Oriented</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/profitOriented -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/profitOriented">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalGoal"/>
        <rdfs:comment xml:lang="en">An organizational goal emphasizing financial returns.</rdfs:comment>
        <rdfs:label xml:lang="en">Profit Oriented</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/proposal -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/proposal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAOGovernance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/cancelled"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/cancelledAt"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/createdAt"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/didPass"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/endDate"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/processed"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/processedAt"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/startDate"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Proposal"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Proposal"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A governance item submitted or developed for consideration. It is distinct from its text, voting process and resulting decision.</rdfs:comment>
        <rdfs:label xml:lang="en">Proposal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Proposal"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/proposalPassThreshold -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/proposalPassThreshold">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAOGovernance"/>
        <rdfs:comment xml:lang="en">A rule specifying the approval or participation condition required for a proposal to pass.</rdfs:comment>
        <rdfs:label xml:lang="en">Proposal Pass Threshold</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/proposalText -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/proposalText">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/documents"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#ProposalDocument"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#ProposalDocument"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A textual representation of a proposal, distinct from the proposal and the process that decides it.</rdfs:comment>
        <rdfs:label xml:lang="en">Proposal Text</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#ProposalDocument"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/quadraticVoting -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/quadraticVoting">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/votingScheme"/>
        <rdfs:comment xml:lang="en">A voting scheme using a quadratic relationship between voting influence and its associated cost or allocation rule. The exact rule is specified by the scheme.</rdfs:comment>
        <rdfs:label xml:lang="en">Quadratic Voting</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/reentrancyAttack -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/reentrancyAttack">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/attack"/>
        <rdfs:comment xml:lang="en">An attack exploiting repeated or nested entry into contract logic before its intended state updates are complete.</rdfs:comment>
        <rdfs:label xml:lang="en">Reentrancy Attack</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/regulatoryInitiative -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/regulatoryInitiative">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/legalFramework"/>
        <rdfs:comment xml:lang="en">A proposed or developing regulatory measure relevant to the modeled domain.</rdfs:comment>
        <rdfs:label xml:lang="en">Regulatory Initiative</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/reputation -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/reputation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/reward"/>
        <rdfs:comment xml:lang="en">A reward or recognition based on standing, contribution or perceived trustworthiness.</rdfs:comment>
        <rdfs:label xml:lang="en">Reputation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/reward -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/reward">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAOGovernance"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalManifestationLayer"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <rdfs:comment xml:lang="en">An incentive or benefit provided for contribution, participation or other organizational behavior.</rdfs:comment>
        <rdfs:label xml:lang="en">Reward / Incentive</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/sale -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/sale">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/transaction"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/hasBuyer"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/hasSeller"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <st:relationArity xml:lang="en">Reified n-ary relation: seller, buyer, token resource(s); optional DAO context and transfer records.</st:relationArity>
        <rdfs:comment xml:lang="en">A token-bearing sale event with one seller, one buyer and at least one transacted token resource. A composite sale with several sellers or buyers is represented by several sale events. Payment terms can be documented separately.</rdfs:comment>
        <rdfs:label xml:lang="en">Sale</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/securityRisk -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/securityRisk">
        <rdfs:comment>Cross-cutting security aspects concerning all other layers.</rdfs:comment>
        <rdfs:label xml:lang="en">Security Risk</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/securityToken -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/securityToken">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#SecurityToken"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#SecurityToken"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A token modeled as representing investment or financial rights under the legal classification applicable to the specific case. The ontology does not determine that classification.</rdfs:comment>
        <rdfs:label xml:lang="en">Security Token</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#SecurityToken"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/selfSovereignIdentityProvider -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/selfSovereignIdentityProvider">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/identityManagementSystem"/>
        <rdfs:comment xml:lang="en">An identity-management provider or mechanism supporting participant control over identity information and credentials.</rdfs:comment>
        <rdfs:label xml:lang="en">Self Sovereign Identity Provider</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/smartContractAccount -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/smartContractAccount">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchainAccount"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#ContractAccount"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#SmartContract"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#ContractAccount"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#SmartContract"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A blockchain account whose contract logic can execute when invoked. It is modeled separately from externallyOwnedAccount. Account capabilities depend on the underlying platform and account design.</rdfs:comment>
        <rdfs:label xml:lang="en">Smart Contract Account</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#ContractAccount"/>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#SmartContract"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/smartContractContent -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/smartContractContent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/documents"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#SmartContract"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">The code or formal content associated with a smart contract, distinct from the account at which it is deployed.</rdfs:comment>
        <rdfs:label xml:lang="en">Smart Contract Content</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#SmartContract"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/sociallyOriented -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/sociallyOriented">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalGoal"/>
        <rdfs:comment xml:lang="en">An organizational goal emphasizing social or community purposes.</rdfs:comment>
        <rdfs:label xml:lang="en">Socially Oriented</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/specialRightsAllocation -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/specialRightsAllocation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalStatus"/>
        <rdfs:comment xml:lang="en">An allocation of particular decision or governance rights to specified participants or teams.</rdfs:comment>
        <rdfs:label xml:lang="en">Special Rights Allocation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/stakedFunds -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/stakedFunds">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/commonResources"/>
        <rdfs:comment xml:lang="en">Funds committed or locked in connection with participation, governance or protocol operation.</rdfs:comment>
        <rdfs:label xml:lang="en">Staked Funds</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/sybilAttack -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/sybilAttack">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/attack"/>
        <rdfs:comment xml:lang="en">An attack using multiple identities to obtain influence or evade assumptions about independent participants.</rdfs:comment>
        <rdfs:label xml:lang="en">Sybil Attack</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/team -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/team">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organization"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Committee"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A group carrying coordinated responsibilities within an organization.</rdfs:comment>
        <rdfs:label xml:lang="en">Team</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Committee"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer">
        <rdfs:comment>The technical/artefactual layer encompasses blockchain infrastructure, smart contracts, protocol architecture, and token design.</rdfs:comment>
        <rdfs:label xml:lang="en">Technical Artefactual Layer</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/technicalProposal -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/technicalProposal">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposal"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Others"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A proposal concerned with technical design, implementation or operation.</rdfs:comment>
        <rdfs:label xml:lang="en">Technical Proposal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Others"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/technicalTeam -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/technicalTeam">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/team"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Tech"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A team carrying technical development, infrastructure or maintenance responsibilities.</rdfs:comment>
        <rdfs:label xml:lang="en">Technical Team</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Tech"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/token -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/token">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAOGovernance"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Token"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Token"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A modeled digital asset resource, such as a token type or an identified non-fungible token. Quantities of fungible units are represented separately in tokenTransferRecord and tokenHolding. Select a consistent resource granularity for each dataset.</rdfs:comment>
        <rdfs:label xml:lang="en">Token</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Token"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/tokenContract -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/tokenContract">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/smartContractAccount"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#TokenContract"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#TokenContract"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A smart contract account implementing or managing token assets. It may implement fungible or non-fungible tokens; a native coin need not have a token contract.</rdfs:comment>
        <rdfs:label xml:lang="en">Token Contract</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#TokenContract"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/tokenDelegation -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/tokenDelegation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAOGovernance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/delegatedToken"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/delegationForDAO"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAO"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/delegationFrom"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/delegationTo"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/delegateVoter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenAmount"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</xsd:minExclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenAmount"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/validFrom"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/validUntil"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <st:relationArity xml:lang="en">Reified n-ary relation: delegator, delegate voter, token, DAO; optional quantity and validity interval.</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#delegateKey"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A context-specific delegation record linking one delegator, one delegate voter, one token resource and one DAO. Use separate records for different token resources or contexts. Quantity and validity dates are optional. Delegation need not transfer ownership.</rdfs:comment>
        <rdfs:label xml:lang="en">Token Delegation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#delegateKey"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/tokenDistribution -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/tokenDistribution">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalStatus"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <rdfs:comment xml:lang="en">An arrangement, mechanism or observed pattern of token allocation. It includes distribution mechanisms such as ICOs and measurable distributions.</rdfs:comment>
        <rdfs:label xml:lang="en">Token Distribution</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/tokenHolding -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/tokenHolding">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalStatus"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/heldToken"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/holdingBy"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/blockchainAccount"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/member"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organization"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/holdingInTreasury"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/multiSignatureWallet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenAmount"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</xsd:minExclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/observedAt"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenAmount"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Holds"/>
        <st:relationArity xml:lang="en">Reified n-ary relation: holder, token, quantity, observation time; optional treasury context.</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Holds"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">An observation of one holder possessing one token resource with a strictly positive quantity at one observation time. The holder may be a member, organization or blockchain account. Optional treasury context identifies where an asset is held.</rdfs:comment>
        <rdfs:label xml:lang="en">Token Holding</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Holds"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/tokenOwner -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/tokenOwner">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
        <rdfs:comment xml:lang="en">A member acting in a token-owner role in this model.</rdfs:comment>
        <rdfs:label xml:lang="en">Token Owner</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/tokenStandard -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/tokenStandard">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <rdfs:comment xml:lang="en">A specification defining an interface or expected behavior for token implementations. A specification resource identifies the relevant standard and version when versions are distinguished.</rdfs:comment>
        <rdfs:label xml:lang="en">Token Standard</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/tokenTransferRecord -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/tokenTransferRecord">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/transferRecipient"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/blockchainAccount"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/member"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organization"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/transferRecordOfTransaction"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/transaction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/transferSender"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/blockchainAccount"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/member"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organization"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/transferToken"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenAmount"/>
                <owl:allValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</xsd:minExclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenAmount"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <st:relationArity xml:lang="en">Reified n-ary relation: transaction, token, sender, recipient, quantity.</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#tranfersFund"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A line item within one token-bearing transaction. It identifies one transferred token resource, one sender, one recipient and a strictly positive quantity, preserving which quantity belongs to which token and transfer.</rdfs:comment>
        <rdfs:label xml:lang="en">Token Transfer Record</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#tranfersFund"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/transaction -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/transaction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/exchange"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalManifestationLayer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/hasTransactedToken"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A token-bearing exchange in this ontology, including an off-chain exchange. It involves at least one token resource through hasTransactedToken. Generic blockchain transactions, including zero-token calls and deployments, use blockchainTransaction. An on-chain token-bearing exchange can instantiate both classes; neither class is declared a subclass of the other.</rdfs:comment>
        <rdfs:label xml:lang="en">Transaction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/transactionalToken -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/transactionalToken">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/utilityToken"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Cryptocurrency"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment>Cryptocurrencies that can be traded between platforms</rdfs:comment>
        <rdfs:label xml:lang="en">Transactional Token</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Cryptocurrency"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/utilityToken -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/utilityToken">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#UtilityToken"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#UtilityToken"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A token associated with access to a service or functionality. This functional description does not by itself imply a legal exemption or a particular issuance mechanism.</rdfs:comment>
        <rdfs:label xml:lang="en">Utility Token</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#UtilityToken"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/voteMajority -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/voteMajority">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposalPassThreshold"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/gisa/STDAO/voterMajority"/>
        <rdfs:comment xml:lang="en">A proposal pass threshold defined in terms of votes or voting weight.</rdfs:comment>
        <rdfs:label xml:lang="en">Vote Majority</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/voteParticipation -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/voteParticipation">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalStatus"/>
        <rdfs:comment xml:lang="en">A broad voting-observation category encompassing participation measures and outcome records.</rdfs:comment>
        <rdfs:label xml:lang="en">Vote Participation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/voterMajority -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/voterMajority">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposalPassThreshold"/>
        <rdfs:comment xml:lang="en">A proposal pass threshold defined in terms of the number of participating or eligible voters.</rdfs:comment>
        <rdfs:label xml:lang="en">Voter Majority</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/voterTurnout -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/voterTurnout">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/voteParticipation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/isVoterN"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A participation observation describing how many eligible or relevant voters participated.</rdfs:comment>
        <rdfs:label xml:lang="en">Voter Turnout</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/votesResult -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/votesResult">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/voteParticipation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/isVoteN"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A recorded voting outcome.</rdfs:comment>
        <rdfs:label xml:lang="en">Votes Result</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/votingContract -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/votingContract">
