    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/distributionIsReflectedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/distributionIsReflectedIn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/reflectsTokenDistribution"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenDistribution"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/voteParticipation"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Distribution is reflected in. Relates tokenDistribution to voteParticipation.</rdfs:comment>
        <rdfs:label xml:lang="en">Distribution Is Reflected In</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/executeSmartContract -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/executeSmartContract">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isExecutedByContractAccount"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/smartContractAccount"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/smartContractContent"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Execute smart contract. Relates smartContractAccount to smartContractContent.</rdfs:comment>
        <rdfs:label xml:lang="en">Execute Smart Contract</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/exploitsContractVulnerability -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/exploitsContractVulnerability">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/hasVulnerabilityExploited"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/exploitContractVulnerabilityAttack"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/smartContractAccount"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Exploits contract vulnerability. Relates exploitContractVulnerabilityAttack to smartContractAccount.</rdfs:comment>
        <rdfs:label xml:lang="en">Exploits Contract Vulnerability</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/getsDelegatedTokens -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/getsDelegatedTokens">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/receivesDelegatedToken"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/delegateVoter"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a token to the delegate voter to whom its voting authority is delegated. receivesDelegatedToken is the inverse relation. tokenDelegation records the delegator, delegate voter, token and DAO context.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Token Delegated To</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/getsVotingPowerFrom -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/getsVotingPowerFrom">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/givesVotingPower"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/governanceToken"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/specialRightsAllocation"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/stakedFunds"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/votingScheme"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Gets voting power from. Relates tokenOwner to (governanceToken OR specialRightsAllocation OR stakedFunds OR votingScheme).</rdfs:comment>
        <rdfs:label xml:lang="en">Gets Voting Power From</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/givesGovernanceRight -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/givesGovernanceRight">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/governanceRightIsGivenBy"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/governanceToken"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Gives governance right. Relates governanceToken to member.</rdfs:comment>
        <rdfs:label xml:lang="en">Gives Governance Right</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/givesVotingPower -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/givesVotingPower">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/governanceToken"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/specialRightsAllocation"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/stakedFunds"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/votingScheme"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Gives voting power. Relates (governanceToken OR specialRightsAllocation OR stakedFunds OR votingScheme) to tokenOwner.</rdfs:comment>
        <rdfs:label xml:lang="en">Gives Voting Power</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/governanceRightIsGivenBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/governanceRightIsGivenBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/governanceToken"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Governance right is given by. Relates member to governanceToken.</rdfs:comment>
        <rdfs:label xml:lang="en">Governance Right Is Given By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/grantsSpecialRights -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/grantsSpecialRights">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/specialRightsAreGivenBy"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/member"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/team"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/specialRightsAllocation"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a member or team to a special-rights allocation that it grants. This is the reverse of specialRightsAreGivenBy; it does not identify the holder or a reputation-based qualification.</rdfs:comment>
        <rdfs:label xml:lang="en">Grants Special Rights</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasAccount -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasAccount">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/member"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/externallyOwnedAccount"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#hasEOAAccount"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#hasEOAAccount"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Has account. Relates (member OR organization) to externallyOwnedAccount.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Account</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#hasEOAAccount"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasAssetInTreasury -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasAssetInTreasury">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/personalWallet"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Has asset in treasury. Relates personalWallet to token.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Asset In Treasury</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasAssetTreasury -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasAssetTreasury">
        <owl:equivalentProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/hasTreasuryAsset"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isTreasuryAsset"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/multiSignatureWallet"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Has asset treasury. Relates multiSignatureWallet to token.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Asset Treasury</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasBallot -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasBallot">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/ballot"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#eoaHasVotes"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Logical inverse of ballotBy: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Ballot</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#eoaHasVotes"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasBaseRateObservation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasBaseRateObservation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/exchangeRateObservation"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of baseToken: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Base Rate Observation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasBlockchainAccount -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasBlockchainAccount">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchain"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchainAccount"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of accountOnBlockchain: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Blockchain Account</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasBlockchainGovernanceSystem -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasBlockchainGovernanceSystem">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isGovernanceSystemOfBlockchain"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchainPlatform"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO:blockchainGovernance"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Has blockchain governance system. Relates blockchainPlatform to blockchainGovernance.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Blockchain Governance System</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasBlockchainTransaction -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasBlockchainTransaction">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/transactionOnBlockchain"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchain"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchainTransaction"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of transactionOnBlockchain: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Blockchain Transaction</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasBuyer -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasBuyer">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isBuyerInSale"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/sale"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <st:multiplicity xml:lang="en">sale → tokenOwner: 1..1; inverse normally 0..*.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">The single buyer role of one modeled sale event. One buyer may participate in many sales.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Buyer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasComputedHash -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasComputedHash">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isComputedHashOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/block"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/blockHeader"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/hashValue"/>
        <st:multiplicity xml:lang="en">0..* values per subject and 0..* subjects per object. No mandatory existence, global uniqueness or one-to-one constraint is asserted.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a block or block header to a hash output computed from the protocol-specified encoded representation used to identify or verify that resource.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Computed Hash</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasDAOMember -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasDAOMember">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isMemberOfDAO"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAO"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
        <st:multiplicity xml:lang="en">DAO → member: 1..*; inverse normally 0..*.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Connects a technical DAO to a member of that DAO without inferring that the DAO itself is an organization.</rdfs:comment>
        <rdfs:label xml:lang="en">Has DAO Member</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasDAOMembershipRecord -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasDAOMembershipRecord">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/membershipDAO"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAO"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/membershipRecord"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#committeeHasIsMember"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Logical inverse of membershipDAO: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Has DAO Membership Record</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#committeeHasIsMember"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasDecisionalPower -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasDecisionalPower">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isDecisionalPower"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/specialRightsAllocation"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/stakedFunds"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/votingScheme"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Connects a token owner to an individual belonging to the intersection of specialRightsAllocation, stakedFunds and votingScheme.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Decisional Power</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasDelegation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasDelegation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAO"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenDelegation"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of delegationForDAO: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Delegation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasDelegationRecord -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasDelegationRecord">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenDelegation"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of delegatedToken: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Delegation Record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasDominantVoter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasDominantVoter">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isDominantVoter"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/votesResult"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of isDominantVoter: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Dominant Voter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasExchangeRate -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasExchangeRate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/utilityToken"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/utilityToken"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">A token-to-token summary indicating that an exchange-rate relationship is recorded or considered. exchangeRateObservation records the base token, quote token, numeric rate and observation time.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Exchange Rate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasFormalLanguage -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasFormalLanguage">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isFormalLanguageOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/blockContent"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/oracle"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/smartContractContent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/formalLanguage"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Connects a code-bearing artifact or oracle to a formal language in which it is expressed.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Formal Language</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasGovernanceSystem -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasGovernanceSystem">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isGovernanceSystemOfDAO"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAO"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAOGovernance"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Has governance system. Relates DAO to DAOGovernance.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Governance System</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasHoldingObservation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasHoldingObservation">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/heldToken"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenHolding"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#tokenHasHolds"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Logical inverse of heldToken: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Holding Observation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#tokenHasHolds"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasHonestConductByMember -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasHonestConductByMember">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAOGovernance"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
        <st:multiplicity xml:lang="en">0..* values per subject and 0..* subjects per object. The relation is optional and many-to-many.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a DAO-governance arrangement or episode to a member whose conduct in that context is characterized as honest. This is the inverse of actsHonestlyInGovernance.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Honest Conduct By Member</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasIncomingDelegation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasIncomingDelegation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/delegateVoter"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenDelegation"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of delegationTo: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Incoming Delegation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasLanguage -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasLanguage">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isNaturalLanguageOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/contract"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/law"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/proposalText"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/whitepaperText"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/naturalLanguage"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Connects a contract, law, proposal text or whitepaper text to a natural language. These subject types are alternatives.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Natural Language</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasLegalFramework -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasLegalFramework">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isLegalFrameworkFor"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/DAO"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/contract"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/legalFramework"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">A legal framework considered applicable or relevant in this model; applicability must be supported by separate evidence.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Legal Framework</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasLegalInstantiation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasLegalInstantiation">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isLegalInstantiationOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/agreement"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/exchange"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/contract"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Has legal instantiation. Relates (agreement OR exchange) to contract.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Legal Instantiation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasMainContract -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasMainContract">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isBuiltOn"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isMainContractOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/DAO"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/Dapp"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/smartContractAccount"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of isMainContractOf: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Main Contract</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasMember -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasMember">
        <owl:equivalentProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/isComposedOfMembers"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isMember"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/organization"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Has member. Relates organization to member.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Member</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasMembershipRecord -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasMembershipRecord">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/membershipMember"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/membershipRecord"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#eoaHasIsMember"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Logical inverse of membershipMember: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Membership Record</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#eoaHasIsMember"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasMinorityVoter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasMinorityVoter">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isMinorityVoter"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/votesResult"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of isMinorityVoter: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Minority Voter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasOrganizationalGoal -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasOrganizationalGoal">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isGoalOfOrganization"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/organization"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalGoal"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">A purpose pursued by the organization. Multiple goals and shared goals are permitted.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Organizational Goal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasOutgoingDelegation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasOutgoingDelegation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenDelegation"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of delegationFrom: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Outgoing Delegation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasPassThreshold -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasPassThreshold">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isPassThreshold"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposal"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposalPassThreshold"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Has pass threshold. Relates proposal to proposalPassThreshold.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Pass Threshold</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasPersonalWallet -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasPersonalWallet">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isPersonalWallet"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/personalWallet"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Has personal wallet. Relates member to personalWallet.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Personal Wallet</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasProposal -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasProposal">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isProposalOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/DAO"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposal"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#receivesProposal"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Has proposal. Relates (DAO OR organization) to proposal.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Proposal</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#receivesProposal"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasQuoteRateObservation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasQuoteRateObservation">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/quoteToken"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/exchangeRateObservation"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of quoteToken: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Quote Rate Observation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasRisk -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasRisk">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isRiskFor"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/DAO"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/blockchainAccount"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organization"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/platform"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/centralizationRisk"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/securityRisk"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">An assessed security or centralization risk associated with the modeled entity. This assertion records an assessment, not a proven future outcome.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Risk</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasSale -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasSale">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/saleForDAO"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAO"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/sale"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of saleForDAO: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Sale</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasSeller -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasSeller">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isSellerInSale"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/sale"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <st:multiplicity xml:lang="en">sale → tokenOwner: 1..1; inverse normally 0..*.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">The single seller role of one modeled sale event. One seller may participate in many sales.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Seller</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasSideChain -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasSideChain">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isSideChainOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchainPlatform"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchainPlatform"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#hasSidechain"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#hasSidechain"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Has side chain. Relates blockchainPlatform to blockchainPlatform.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Side Chain</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#hasSidechain"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasSpecialRights -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasSpecialRights">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/specialRightsAreHeldBy"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/member"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/team"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/specialRightsAllocation"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a member or team to a special-rights allocation that it holds. Holding rights is distinct from granting them and from the reputation or other basis used to qualify for them.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Special Rights</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasStrategicConductByMember -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasStrategicConductByMember">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organizationalGoal"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organizationalStatus"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/reward"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
        <st:multiplicity xml:lang="en">0..* values per subject and 0..* subjects per object. The relation is optional and many-to-many.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a DAO-governance arrangement or episode to a member whose conduct in that context is characterized as strategic. This is the inverse of actsStrategicallyInGovernance.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Strategic Conduct By Member</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasStrategy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasStrategy">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isStrategyOfMember"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/votingStrategy"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a member to a voting strategy associated with that member. The strategy can be connected to its governance context through strategyAppliesToGovernance; no direct-voter role or behavioral flag follows solely from this association.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Strategy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasSubDao -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasSubDao">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isSubDaoOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAO"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAO"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#SubDAO"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Has sub dao. Relates DAO to DAO.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Sub Dao</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#SubDAO"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasTeam -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasTeam">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isTeamOfOrganization"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/organization"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/team"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">A team participating in the organization; shared teams are permitted.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Team</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasToken -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasToken">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isTokenOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/DAO"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#supportsToken"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Has token. Relates (DAO OR organization) to token.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Token</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#supportsToken"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasTokenHolding -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasTokenHolding">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/holdingBy"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/blockchainAccount"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/member"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenHolding"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#eoaHasHolds"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Logical inverse of holdingBy: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Token Holding</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#eoaHasHolds"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasTransactedToken -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasTransactedToken">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isTokenInTransaction"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/transaction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <st:multiplicity xml:lang="en">transaction → token: 1..*; inverse normally 0..*.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Identifies a token resource involved in this token-bearing exchange. Cardinality counts distinct token resources, not fungible units.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Transacted Token</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasTransferRecord -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasTransferRecord">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/transferRecordOfTransaction"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/transaction"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenTransferRecord"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Links a transaction to separate token/quantity/sender/recipient line items.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Transfer Record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasTransferRecordForToken -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasTransferRecordForToken">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/transferToken"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenTransferRecord"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of transferToken: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Transfer Record For Token</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasTreasury -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasTreasury">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isTreasuryOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/DAO"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/commonResources"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/multiSignatureWallet"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#sharesCryptoWallet"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Relates (DAO OR organization) to (commonResources OR multiSignatureWallet).</rdfs:comment>
        <rdfs:label xml:lang="en">Has Treasury</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#sharesCryptoWallet"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasTreasuryAsset -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasTreasuryAsset">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isAssetInTreasury"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/multiSignatureWallet"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Has treasury asset. Relates multiSignatureWallet to token.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Treasury Asset</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasTreasuryHolding -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasTreasuryHolding">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/holdingInTreasury"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/multiSignatureWallet"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenHolding"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of holdingInTreasury: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Treasury Holding</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasVotingProcess -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasVotingProcess">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isVotingProcessOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/proposal"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/proposalText"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/votingProcess"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Connects an individual belonging to both proposal and proposalText to a votingProcess record. Schemes, thresholds, ballots and results are linked to that process through separate predicates.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Voting Process</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasVotingScheme -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/hasVotingScheme">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isVotingScheme"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposal"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/votingScheme"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates proposal to votingScheme.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Voting Scheme</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/hasVulnerabilityExploited -->

