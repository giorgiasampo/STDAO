    <!-- http://www.semanticweb.org/gisa/STDAO/delegatedToken -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/delegatedToken">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/hasDelegationRecord"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenDelegation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
