    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isComposedOfMembers -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isComposedOfMembers">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/organization"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/member"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Is composed of members. Relates organization to member.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Composed Of Members</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isComputedHashOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isComputedHashOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/hashValue"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/block"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/blockHeader"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">0..* values per subject and 0..* subjects per object. No mandatory existence, global uniqueness or one-to-one constraint is asserted.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a hash output to a block or block header whose protocol-specified encoded representation was used to compute it. This is the exact inverse of hasComputedHash.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Computed Hash Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isContentOfBlock -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isContentOfBlock">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/blockContent"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/blockHeader"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/block"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates recorded blockchain information to a block of which it is part. This is the exact inverse of blockContains and has the same information-containment scope.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Content Of Block</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isContractParty -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isContractParty">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/externallyOwnedAccount"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/contract"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Is contract party. Relates externallyOwnedAccount to contract.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Contract Party</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isCorrespondedThrough -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isCorrespondedThrough">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/reward"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Reward conveyed through. Relates reward to token.</rdfs:comment>
        <rdfs:label xml:lang="en">Reward Conveyed Through</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isDecentralizedWayToSolve -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isDecentralizedWayToSolve">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/solvesInDecentralizedWay"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/conflictResolutionMechanism"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/conflict"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Is decentralized way to solve. Relates conflictResolutionMechanism to conflict.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Decentralized Way To Solve</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isDecisionalPower -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isDecisionalPower">
        <rdfs:domain>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/specialRightsAllocation"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/stakedFunds"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/votingScheme"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of hasDecisionalPower. Its subject is simultaneously a specialRightsAllocation, stakedFunds and votingScheme individual.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Decisional Power</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isDeterminedByGovernanceSetUp -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isDeterminedByGovernanceSetUp">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalStatus"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/governanceProposal"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Is determined by governance set up. Relates organizationalStatus to governanceProposal.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Determined By Governance Set Up</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isDeterminedByVotes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isDeterminedByVotes">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/votesResult"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/voteParticipation"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/votingScheme"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates votesResult to (voteParticipation AND votingScheme).</rdfs:comment>
        <rdfs:label xml:lang="en">Voting Result Depends On</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isDirectVoter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isDirectVoter">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAO"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Is direct voter. Relates tokenOwner to DAO.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Direct Voter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isDominantVoter -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isDominantVoter">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/votesResult"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Is dominant voter. Relates tokenOwner to votesResult.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Dominant Voter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isEconomicReward -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isEconomicReward">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isTokenForEconomicReward"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/economic"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Connects an economic reward to a token through which it is conveyed. It is independent of reputation rewards.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Economic Reward</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isEmployedForVotingOn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isEmployedForVotingOn">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isVotedOnThrough"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/governanceToken"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/proposal"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/proposalText"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#isVotingToken"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Relates governanceToken to (proposal AND proposalText).</rdfs:comment>
        <rdfs:label xml:lang="en">Is Employed For Voting On</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#isVotingToken"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isExchangeEnvironmentFor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isExchangeEnvironmentFor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/exchangePlatform"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Is exchange environment for. Relates exchangePlatform to token.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Exchange Environment For</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isExecutedByContractAccount -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isExecutedByContractAccount">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/smartContractContent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/smartContractAccount"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of executeSmartContract: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Executed By Contract Account</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isFormalLanguageOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isFormalLanguageOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/formalLanguage"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/blockContent"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/oracle"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/smartContractContent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of hasFormalLanguage: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Formal Language Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isGoalOfOrganization -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isGoalOfOrganization">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalGoal"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/organization"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of hasOrganizationalGoal: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Goal Of Organization</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isGovernanceSystemOfBlockchain -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isGovernanceSystemOfBlockchain">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO:blockchainGovernance"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchainPlatform"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Is governance system of blockchain. Relates blockchainGovernance to blockchainPlatform.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Governance System Of Blockchain</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isGovernanceSystemOfDAO -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isGovernanceSystemOfDAO">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAOGovernance"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAO"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Is governance system of dao. Relates DAOGovernance to DAO.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Governance System Of DAO</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isHashValueInHeader -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isHashValueInHeader">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/hashValue"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockHeader"/>
        <st:multiplicity xml:lang="en">0..* values per subject and 0..* subjects per object. No mandatory existence, global uniqueness or one-to-one constraint is asserted.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a recorded hash-output resource to a block header containing that value. This is the exact inverse of headerHasHashValue.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Hash Value In Header</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isHeaderOfBlock -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isHeaderOfBlock">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isContentOfBlock"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockHeader"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/block"/>
        <st:multiplicity xml:lang="en">0..* values per subject and 0..* subjects per object. No mandatory existence, global uniqueness or one-to-one constraint is asserted.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a block header to the block of which it is a header. This is the exact inverse of blockHasHeader.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Header Of Block</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isHinderedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isHinderedBy">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/reentrancyAttack"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/sybilAttack"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/51attack"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/identityManagementSystem"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Is hindered by. Relates (51attack OR reentrancyAttack OR sybilAttack) to identityManagementSystem.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Hindered By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isHostedOn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isHostedOn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposalText"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/votingPlatform"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Is hosted on. Relates proposalText to votingPlatform.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Hosted On</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/isHostingProposal -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/isHostingProposal">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/isProposalDevelopedOn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposal"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposalText"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#includesProposalDocument"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
