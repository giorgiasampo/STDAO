        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/commonResources"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Stores common resources. Relates multiSignatureWallet to commonResources.</rdfs:comment>
        <rdfs:label xml:lang="en">Stores Common Resources</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/supportsApplication -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/supportsApplication">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/smartContractAccount"/>
