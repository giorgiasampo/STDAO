    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/processHasResult">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/resultOfProcess"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/votingProcess"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/votesResult"/>
