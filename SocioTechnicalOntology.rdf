        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Status quo is shaped by. Relates organizationalStatus to governanceIntermediationLayer.</rdfs:comment>
        <rdfs:label xml:lang="en">Status Quo Is Shaped By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/storesCommonResources -->

