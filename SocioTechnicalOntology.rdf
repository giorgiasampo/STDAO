        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">The one token resource whose voting authority is delegated by this record.</rdfs:comment>
        <rdfs:label xml:lang="en">Delegated Token</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/delegationForDAO -->

