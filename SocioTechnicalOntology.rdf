        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Determine governance. Relates governanceProposal to organizationalStatus.</rdfs:comment>
        <rdfs:label xml:lang="en">Determine Governance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/determinesVoterTurnout -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/determinesVoterTurnout">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/voterTurnoutDeterminedBy"/>
