    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/quoteToken">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/exchangeRateObservation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <st:multiplicity xml:lang="en">exchangeRateObservation → token: 1..1; inverse normally 0..*.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">The token in whose units the base token is priced.</rdfs:comment>
        <rdfs:label xml:lang="en">Quote Token</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/receivesDelegatedToken -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/receivesDelegatedToken">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/delegateVoter"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/token"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of getsDelegatedTokens: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Receives Delegated Token</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/receivesExternalInformation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/receivesExternalInformation">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/transmitsExternalInformation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/smartContractAccount"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/iotDevice"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/oracle"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#receivesExternalInformation"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#receivesExternalInformation"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Receives external information. Relates smartContractAccount to (iotDevice OR oracle).</rdfs:comment>
        <rdfs:label xml:lang="en">Receives External Information</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#receivesExternalInformation"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/receivesRewardForMining -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/receivesRewardForMining">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/rewardsMiningParticipationOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/miner"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/reward"/>
        <st:multiplicity xml:lang="en">0..* values per subject and 0..* subjects per object. The relation is optional and many-to-many.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a miner to a reward or incentive awarded for their mining activity. This is the inverse of rewardsMiningParticipationOf.</rdfs:comment>
        <rdfs:label xml:lang="en">Receives Reward For Mining</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/receivesRewardForVotingParticipation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/receivesRewardForVotingParticipation">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/rewardsVotingParticipationOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/reward"/>
        <st:multiplicity xml:lang="en">0..* values per subject and 0..* subjects per object. The relation is optional and many-to-many.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a token owner to a reward or incentive awarded for their voting participation. This is the inverse of rewardsVotingParticipationOf.</rdfs:comment>
        <rdfs:label xml:lang="en">Receives Reward For Voting Participation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/receivesSmartContractRequests -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/receivesSmartContractRequests">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/oracle"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/oracleAccount"/>
        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#receivesSmartContractRequests"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#receivesSmartContractRequests"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">Receives smart contract requests. Relates oracle to oracleAccount.</rdfs:comment>
        <rdfs:label xml:lang="en">Receives Smart Contract Requests</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#receivesSmartContractRequests"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/receivesTransferRecord -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/receivesTransferRecord">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/transferRecipient"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/blockchainAccount"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/member"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenTransferRecord"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of transferRecipient: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Receives Transfer Record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/reflectsTokenDistribution -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/reflectsTokenDistribution">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/voteParticipation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenDistribution"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Reflects token distribution. Relates voteParticipation to tokenDistribution.</rdfs:comment>
        <rdfs:label xml:lang="en">Reflects Token Distribution</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/reputationEnablesSpecialRightsAllocation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/reputationEnablesSpecialRightsAllocation">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/specialRightsAllocationEnabledByReputation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/reputation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/specialRightsAllocation"/>
        <st:multiplicity xml:lang="en">0..* values per subject and 0..* subjects per object. The relation is optional and many-to-many.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a reputation reward or recognition to a special-rights allocation for which it is a qualifying basis under the applicable governance rules.</rdfs:comment>
        <rdfs:label xml:lang="en">Reputation Enables Special Rights Allocation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/resultOfProcess -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/resultOfProcess">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/votesResult"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/votingProcess"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of processHasResult: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Result Of Process</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/rewardsMiningParticipationOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/rewardsMiningParticipationOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/reward"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/miner"/>
        <st:multiplicity xml:lang="en">0..* values per subject and 0..* subjects per object. The relation is optional and many-to-many.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a reward or incentive to a miner to whom it is awarded for that miner&apos;s mining activity.</rdfs:comment>
        <rdfs:label xml:lang="en">Rewards Mining Participation Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/rewardsVotingParticipationOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/rewardsVotingParticipationOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/reward"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <st:multiplicity xml:lang="en">0..* values per subject and 0..* subjects per object. The relation is optional and many-to-many.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a reward or incentive to a token owner to whom it is awarded for that owner&apos;s voting participation in the relevant voting context.</rdfs:comment>
        <rdfs:label xml:lang="en">Rewards Voting Participation Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/saleForDAO -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/saleForDAO">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/sale"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAO"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Optional DAO context of a sale; cross-DAO cases may use more than one context.</rdfs:comment>
        <rdfs:label xml:lang="en">Sale For DAO</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/schemeUsedByProcess -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/schemeUsedByProcess">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/votingScheme"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/votingProcess"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of processUsesScheme: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Scheme Used By Process</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/sellsTokenTo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/sellsTokenTo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenOwner"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">A seller-to-buyer summary of a token sale. Use a sale individual for token identity, quantity, transaction and time context.</rdfs:comment>
        <rdfs:label xml:lang="en">Sells Token To</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/sendsTransferRecord -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/sendsTransferRecord">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/transferSender"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/blockchainAccount"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/member"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/tokenTransferRecord"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of transferSender: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Sends Transfer Record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/shapesStatusQuo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/shapesStatusQuo">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/statusQuoIsShapedBy"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO:governanceIntermediationLayer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/organizationalStatus"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a governance-intermediation construct to an organizational status it may influence.</rdfs:comment>
        <rdfs:label xml:lang="en">Shapes Status Quo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/smartContractIsDevelopedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/smartContractIsDevelopedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/smartContractAccount"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/member"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/organization"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Smart contract is developed by. Relates smartContractAccount to (member OR organization).</rdfs:comment>
        <rdfs:label xml:lang="en">Smart Contract Is Developed By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/solvesInCentralizedWay -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/solvesInCentralizedWay">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/conflict"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/law"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Solves in centralized way. Relates conflict to law.</rdfs:comment>
        <rdfs:label xml:lang="en">Solves In Centralized Way</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/solvesInDecentralizedWay -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/solvesInDecentralizedWay">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/conflict"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/conflictResolutionMechanism"/>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Solves in decentralized way. Relates conflict to conflictResolutionMechanism.</rdfs:comment>
        <rdfs:label xml:lang="en">Solves In Decentralized Way</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/specialRightsAllocationEnabledByReputation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/specialRightsAllocationEnabledByReputation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/specialRightsAllocation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/gisa/STDAO/reputation"/>
        <st:multiplicity xml:lang="en">0..* values per subject and 0..* subjects per object. The relation is optional and many-to-many.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a special-rights allocation to the reputation reward or recognition that is a qualifying basis for it. This is the inverse of reputationEnablesSpecialRightsAllocation.</rdfs:comment>
        <rdfs:label xml:lang="en">Special Rights Allocation Enabled By Reputation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/specialRightsAreGivenBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/specialRightsAreGivenBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/specialRightsAllocation"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/member"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/team"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a special-rights allocation to the member or team that grants those rights. It identifies the grantor, not the holder or the qualifying basis.</rdfs:comment>
        <rdfs:label xml:lang="en">Special Rights Are Given By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/specialRightsAreHeldBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/specialRightsAreHeldBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/gisa/STDAO/specialRightsAllocation"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/member"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/gisa/STDAO/team"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <st:multiplicity xml:lang="en">Default 0..* values per subject and 0..* subjects per object. No mandatory existence or uniqueness is inferred from a domain/range declaration.</st:multiplicity>
        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a special-rights allocation to the member or team holding those rights. This is the reverse of hasSpecialRights and is separate from the grantor and qualifying basis.</rdfs:comment>
        <rdfs:label xml:lang="en">Special Rights Are Held By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/statusQuoIsChangedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/gisa/STDAO/statusQuoIsChangedBy">
