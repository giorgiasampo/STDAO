        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Relates a voting strategy to a member with whom the strategy is associated. This reverses hasStrategy; its range is member rather than a requirement that the person is a direct voter.</rdfs:comment>
        <rdfs:label xml:lang="en">Is Strategy Of Member</rdfs:label>
    </owl:ObjectProperty>
    


