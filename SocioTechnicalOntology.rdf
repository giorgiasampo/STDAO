        <dcterms:source rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#VotingContract"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#VotingContract"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A smart contract account implementing voting operations on proposals.</rdfs:comment>
        <rdfs:label xml:lang="en">Voting Contract</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#VotingContract"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/votingPlatform -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/votingPlatform">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/platform"/>
        <rdfs:comment xml:lang="en">A platform supporting the submission, execution or recording of governance votes.</rdfs:comment>
        <rdfs:label xml:lang="en">Voting Platform</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/votingProcess -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/votingProcess">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAOGovernance"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/processUsesScheme"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/votingScheme"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/gisa/STDAO/votingProcessForProposal"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/gisa/STDAO/proposal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <st:relationArity xml:lang="en">Reified n-ary relation: proposal, voting scheme(s), ballots; optional thresholds and results.</st:relationArity>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#VoteDuration"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A particular voting round for exactly one proposal. It uses one or more voting schemes, may specify thresholds and results, and can contain multiple ballots. Draft proposals need not already have a process.</rdfs:comment>
        <rdfs:label xml:lang="en">Voting Process</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#VoteDuration"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/votingScheme -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/votingScheme">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAOGovernance"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/technicalArtefactualLayer"/>
        <rdfs:comment xml:lang="en">A set of rules specifying how voting participation, influence and outcomes are determined.</rdfs:comment>
        <rdfs:label xml:lang="en">Voting Scheme</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/votingStrategy -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/votingStrategy">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/DAOGovernance"/>
        <rdfs:comment xml:lang="en">A strategy used by a voter when deciding whether or how to participate. The class describes strategies rather than making honesty and strategic conduct mutually exclusive.</rdfs:comment>
        <rdfs:label xml:lang="en">Voting Strategy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/web3WalletAccount -->

    <owl:Class rdf:about="http://www.semanticweb.org/gisa/STDAO/web3WalletAccount">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/gisa/STDAO/blockchainAccount"/>
        <st:sourceEntity rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Web3Wallet"/>
        <st:sourceOntology rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO"/>
        <st:sourceVersion rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO/v1.0.0"/>
        <rdfs:comment xml:lang="en">A blockchain account operated through wallet facilities. It may use external-key or contract-based control; wallet software and platforms are modeled separately.</rdfs:comment>
        <rdfs:label xml:lang="en">Web3 Wallet Account</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.fdi.ucm.es/disia/ont/web3/DAO#Web3Wallet"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/gisa/STDAO/web3WalletPlatform -->

