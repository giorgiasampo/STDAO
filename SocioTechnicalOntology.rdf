        <st:relationArity rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</st:relationArity>
        <rdfs:comment xml:lang="en">Logical inverse of votingProcessForProposal: reverses exactly the same relationship.</rdfs:comment>
        <rdfs:label xml:lang="en">Proposal Has Voting Process</rdfs:label>
    </owl:ObjectProperty>
    


